# Copy to .env.local for local development
# Production: set the same vars on VPS / Docker

# Site
NEXT_PUBLIC_SITE_NAME=Taylor
NEXT_PUBLIC_SITE_URL=https://yywtaylor.cyou

# Admin login (optional legacy fallback)
# Primary accounts live in SQLite `users` table (seeded on startup).
# Demo: demo@yywtaylor.cyou / demo1234 (read-only)
ADMIN_EMAIL=
# Optional fallback only — prefer DB users. If set, must be bcrypt (b64: recommended):
# ADMIN_PASSWORD=b64:replace_with_output_from_hash_password

# JWT secret: openssl rand -base64 32
AUTH_SECRET=replace_with_a_long_random_string_at_least_32_chars

# Optional LLM for /assistant (OpenAI-compatible). Without these, local hybrid retrieval is used.
# AI_API_KEY=sk-xxx
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# Optional remote embeddings (only when model is set). Local keyword+vector hybrid always works.
# AI_EMBEDDING_MODEL=text-embedding-3-small
# AI_EMBEDDINGS=0
